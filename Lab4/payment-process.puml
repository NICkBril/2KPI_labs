@startuml
title Оплата оренди та автоматичне скасування (UC-06, UC-07, UNB-3)
skinparam shadowing false

|Клієнт|
|iCARus|
|Платіжна система|

|iCARus|
start
note right
  Початок: оренда зі статусом "запланована",
  оплачена не повністю
end note

repeat
  :Чекати на подію;
  note right
    Клієнт ініціював платіж,
    платіжна система надіслала результат
    або настав дедлайн
  end note
  switch (Що сталося?)
  case (UC-06: клієнт натиснув "Оплатити")
    |Клієнт|
    :Обрати суму платежу;
    |iCARus|
    if (Клієнт авторизований, оренда його\nі має статус "запланована"?) then (так)
      :Створити Payment зі статусом\n"очікується підтвердження";
      note right: Припущення 1
      :Надіслати платіжний запит;
    else (ні)
      :Відмовити в оплаті;
    endif
  case (UC-07: платіжна система надіслала результат)
    |Платіжна система|
    :Обробити платіж і надіслати результат;
    |iCARus|
    if (Результат із цим ідентифікатором\nтранзакції вже оброблено?) then (так)
      :Ігнорувати повторний результат;
      note right
        NFR-13
        Повернення до очікування
        наступної події
      end note
    else (ні)
      if (Платіж успішний?) then (так)
        :Записати Payment.status = "сплачено";
        note right: ED-4
        if (Оренду вже скасовано?) then (так)
          :Не відновлювати скасовану оренду;
          note right: Припущення 4
        else (ні)
          fork
            :Підрахувати суму платежів\nзі статусом "сплачено";
          fork again
            :Показати клієнту підтвердження\nцього платежу;
          end fork
          if (Сума не менша за Rental.price?) then (так)
            :Вважати оренду оплаченою;
            note right: UB-6, G-4
          else (ні)
            :Оренда лишається неоплаченою;
            note right
              UB-6, G-10
              Повернення до очікування
              наступної події
            end note
          endif
        endif
      else (ні)
        :Встановити Payment.status = "скасовано";
        :Показати клієнту, що платіж не пройшов;
        note right
          Припущення 3
          Повернення до очікування
          наступної події
        end note
      endif
    endif
  case (UNB-3: минуло 24 години після Rental.startDate)
    |iCARus|
    if (Оренда досі "запланована"\nі не оплачена повністю?) then (так)
      :Змінити статус оренди на "скасована";
      note right
        Період автомобіля вільний (SD-1)
        G-5
      end note
    else (ні)
      :Нічого не робити;
    endif
  endswitch
repeat while (Оренда "запланована" і не оплачена повністю?) is (так) not (ні)

stop
@enduml